{
    "name": "whiskerent/whisker-cart",
    "type": "project",
    "description": "Free, self-hosted e-commerce for PHP and MySQL. Runs with no dependencies; Composer is optional.",
    "keywords": ["ecommerce", "e-commerce", "shop", "cart", "store", "self-hosted", "php", "mysql"],
    "homepage": "https://github.com/WhiskerEnt/Whisker-Cart",
    "license": "proprietary",
    "support": {
        "issues": "https://github.com/WhiskerEnt/Whisker-Cart/issues",
        "wiki": "https://github.com/WhiskerEnt/Whisker-Cart/wiki",
        "source": "https://github.com/WhiskerEnt/Whisker-Cart"
    },
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "post-create-project-cmd": "@php -r \"echo PHP_EOL, 'Whisker is unpacked. Point your web server at this directory and open /install/ in a browser to finish.', PHP_EOL, PHP_EOL;\""
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
